# Copy to deploy/.env on the server (chmod 600) and fill in. Read by the API
# container, and by "docker compose run --rm web-build" for VITE_API_URL.
# Setup: docs/self-hosting.md. Never commit the real .env.
# The database superuser password goes in deploy/db.env, not here.

# Database login of the API. deploy/db.sh init creates pc_api_login with this
# password (openssl rand -hex 24).
PGUSER=pc_api_login
PGPASSWORD=
PGDATABASE=profitpad_crm_db

# Addresses. The UI and API must share a parent domain.
UI_URL=https://crm.example.com
PUBLIC_API_URL=https://api.crm.example.com
CORS_ORIGINS=https://crm.example.com
VITE_API_URL=https://api.crm.example.com
TRUST_PROXY=true

# Keys (openssl rand -base64 32 each). Keep them: a new FILES_URL_KEY breaks
# file links already shared; a new MASTER_ENCRYPTION_KEY makes every stored
# secret unreadable (calendar connections, integration and webhook secrets,
# API keys saved in Settings).
FILES_URL_KEY=
MASTER_ENCRYPTION_KEY=

# Sign-in: Google, Microsoft or both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional (docs/self-hosting.md lists what each does)
# GOOGLE_ALLOWED_DOMAINS=example.com
# MICROSOFT_ALLOWED_DOMAINS=example.com
# MICROSOFT_TENANT=common
# CALENDAR_GOOGLE_DOMAINS=example.com
# DOCS_PUBLIC=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MCP_ALLOWED_ORIGINS=
# FILES_MAX_BYTES=
# PGPOOL_MAX=10
# LOG_LEVEL=info
# PCRM_FILES_DIR=/srv/profitpad_crm_files
