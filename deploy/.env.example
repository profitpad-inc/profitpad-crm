# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
PGUSER=pc_api_login
PGPASSWORD=<pg_password>
PGDATABASE=profitpad_crm_db

CORS_ORIGINS=https://crm.profitpad.com
UI_URL=https://crm.profitpad.com
PUBLIC_API_URL=https://api.crm.profitpad.com
DOCS_PUBLIC=true
TRUST_PROXY=true

FILES_URL_KEY=<random_256_hash_key>
MASTER_ENCRYPTION_KEY=<random_256_hash_key>
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
# GOOGLE_ALLOWED_DOMAINS=profitpad.com    # optional
MICROSOFT_CLIENT_ID=<microsoft_client_id>
MICROSOFT_CLIENT_SECRET=<microsoft_client_secret>
STRIPE_SECRET_KEY=<stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<stripe_webhook_key>