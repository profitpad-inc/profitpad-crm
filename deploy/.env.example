# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
PGUSER=claude_admin
PGPASSWORD=<set on the server only>
PGDATABASE=profitpad_crm_db
CORS_ORIGINS=https://crm.profitpad.com
DOCS_PUBLIC=true
TRUST_PROXY=true
GOOGLE_CLIENT_ID=<set on the server only>
GOOGLE_CLIENT_SECRET=<set on the server only>
PUBLIC_API_URL=https://api.crm.profitpad.com
UI_URL=https://crm.profitpad.com
# optional: GOOGLE_ALLOWED_DOMAINS=profitpad.com
