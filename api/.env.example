# Copy to .env. The database password is read from ~/.pgpass, never stored here.
PGHOST=localhost
PGPORT=5433
PGUSER=claude_admin
PGDATABASE=test_crm
PORT=3000
HOST=127.0.0.1
# Serve /v1/openapi.json and /docs without an API key (fine locally, turn off in production)
DOCS_PUBLIC=true
# Browser origins allowed to call this API (comma-separated), e.g. the GitHub Pages site
CORS_ORIGINS=http://localhost:5173
