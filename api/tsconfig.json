{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "outDir": "dist",
    // the repo root: src/external-url.test.ts imports web's copy of the
    // check (TypeScript 7 defaults rootDir to this folder)
    "rootDir": ".."
  },
  "include": ["src"]
}
