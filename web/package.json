{
  "name": "profitpad-crm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:frame && vite",
    "build": "tsc --noEmit && npm run build:frame && vite build && vite build -c vite.embed.config.ts && vite build -c vite.track.config.ts && cp dist/index.html dist/404.html",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:frame": "vite build -c vite.frame.config.ts --logLevel warn"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "flatpickr": "4.6.13",
    "lucide-react": "1.77.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "recharts": "3.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
