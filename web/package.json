{
  "name": "profitpad-crm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:frame && vite",
    "build": "tsc --noEmit && npm run build:frame && vite build && vite build -c vite.embed.config.ts && cp dist/index.html dist/404.html",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:frame": "vite build -c vite.frame.config.ts --logLevel warn"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@tiptap/core": "2.27.1",
    "@tiptap/extension-link": "2.27.1",
    "@tiptap/extension-placeholder": "2.27.1",
    "@tiptap/extension-underline": "2.27.1",
    "@tiptap/pm": "2.27.1",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "2.27.1",
    "flatpickr": "4.6.13",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
